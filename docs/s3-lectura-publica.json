{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "LeerObjetos",
      "Effect": "Allow",
      "Principal": "*",
      "Action": "s3:GetObject",
      "Resource": "arn:aws:s3:::g3-dsa-proyecto-data/*"
    },
    {
      "Sid": "ListarBucket",
      "Effect": "Allow",
      "Principal": "*",
      "Action": "s3:ListBucket",
      "Resource": "arn:aws:s3:::g3-dsa-proyecto-data"
    }
  ]
}
